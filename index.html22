<!DOCTYPE html>
<html>
<head>
  <title>My Website</title>
  <style>
    body {
      font-family: Arial;
      text-align: center;
      padding: 50px;
      background: #111;
      color: white;
    }
    h1 {
      color: #00ffcc;
    }
    button {
      padding: 10px 20px;
      font-size: 16px;
      background: #00ffcc;
      border: none;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <h1>Welcome to My Website 🚀</h1>
  <p>This site was created from my phone!</p>
  <button onclick="alert('You clicked me! 🎉')">
    Click Me
  </button>
</body>
</html>
